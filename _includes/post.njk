{% set lanes = {
  "romantic": { "name": "Romantic Escapes", "slug": "romantic-escapes", "grad": "linear-gradient(135deg,#3a2566,#c0436b 55%,#ff8a5e)" },
  "nomad":    { "name": "Nomad Life",       "slug": "nomad-life",       "grad": "linear-gradient(135deg,#142a55,#4a2f86 50%,#ffb37a)" },
  "golden":   { "name": "Golden Hour",      "slug": "golden-hour",      "grad": "linear-gradient(135deg,#3a2566,#b14b7a 52%,#ffc15e)" }
} %}
{% set L = lanes[lane] %}
{% set url = "https://tripdusk.com/" + page.fileSlug + ".html" %}
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "analytics.njk" %}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — TripDusk</title>
  <meta name="description" content="{{ description }}" />

  <link rel="canonical" href="{{ url }}" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#190f2b" />
  <meta name="author" content="{{ author }}" />

  <link rel="icon" type="image/svg+xml" href="assets/img/logo.svg" />
  <link rel="apple-touch-icon" href="assets/img/logo.svg" />
  <link rel="manifest" href="site.webmanifest" />

  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="TripDusk" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:url" content="{{ url }}" />
  <meta property="og:image" content="https://tripdusk.com/assets/img/og-image.svg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="article:published_time" content="{{ date | isoDate }}" />
  <meta property="article:section" content="{{ section }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="https://tripdusk.com/assets/img/og-image.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="assets/css/style.css" />

  <!-- Structured data (SEO + GEO) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": "https://tripdusk.com/#organization", "name": "TripDusk", "url": "https://tripdusk.com/", "logo": "https://tripdusk.com/assets/img/logo.svg" },
      { "@type": "WebSite", "@id": "https://tripdusk.com/#website", "url": "https://tripdusk.com/", "name": "TripDusk", "publisher": { "@id": "https://tripdusk.com/#organization" }, "inLanguage": "en" },
      {
        "@type": "BlogPosting",
        "@id": {{ (url + "#article") | dump | safe }},
        "headline": {{ title | dump | safe }},
        "description": {{ description | dump | safe }},
        "image": "https://tripdusk.com/assets/img/og-image.svg",
        "datePublished": {{ (date | isoDate) | dump | safe }},
        "dateModified": {{ (date | isoDate) | dump | safe }},
        "author": { "@type": "Person", "name": {{ author | dump | safe }} },
        "publisher": { "@id": "https://tripdusk.com/#organization" },
        "mainEntityOfPage": {{ url | dump | safe }},
        "articleSection": {{ section | dump | safe }},
        "inLanguage": "en"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tripdusk.com/" },
          { "@type": "ListItem", "position": 2, "name": {{ L.name | dump | safe }}, "item": {{ ("https://tripdusk.com/" + L.slug + ".html") | dump | safe }} },
          { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": {{ url | dump | safe }} }
        ]
      }{% if faq %},
      {
        "@type": "FAQPage",
        "mainEntity": [
          {% for item in faq %}{ "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }{% endif %}
    ]
  }
  </script>
</head>
<body data-page="{{ lane }}">

  <article>
    <section class="page-hero">
      <div class="bg" style="background:{{ L.grad }}"></div>
      <svg class="hills" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="#190f2b" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path opacity="0.5" d="M0 240 L240 180 L520 230 L820 175 L1120 225 L1440 185 V320 H0 Z"/>
        <path d="M0 320 L0 285 L300 255 L640 290 L980 258 L1440 288 V320 Z"/>
      </svg>
      <div class="wrap" style="max-width:820px">
        <p class="crumbs reveal"><a href="index.html">Home</a> / <a href="{{ L.slug }}.html">{{ L.name }}</a> / {{ section }}</p>
        <h1 class="h-xl reveal" data-d="1">{{ title }}</h1>
        <div class="post-meta reveal" data-d="2">
          <span>✍ {{ author }}</span>
          <span>🗓 {{ date | humanDate }}</span>
          <span>⏱ {{ readTime }} min read</span>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:56px">
      <div class="wrap">
        <div class="prose reveal">
          {{ content | safe }}

          {% if faq %}
          <h2>Frequently asked questions</h2>
          {% for item in faq %}
          <h3>{{ item.q }}</h3>
          <p>{{ item.a }}</p>
          {% endfor %}
          {% endif %}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="cta-band reveal">
          <div class="bg"></div>
          <h2 class="h-lg">One golden guide, every Friday</h2>
          <p>Join 25,000 sunset chasers. One place, one itinerary, one photo tip — no noise.</p>
          <form class="subscribe" data-demo>
            <input type="email" placeholder="you@email.com" required aria-label="Email address" />
            <button class="btn btn-light" type="submit">Subscribe</button>
          </form>
          <p class="form-result form-note" style="color:rgba(255,255,255,0.85)"></p>
        </div>
      </div>
    </section>
  </article>

  <script src="assets/js/main.js"></script>
</body>
</html>
