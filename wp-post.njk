---
pagination:
  data: wpposts
  size: 1
  alias: post
permalink: "/{{ post.slug }}/"
eleventyComputed:
  cat: "{{ post.cats[0] or 'Travel' }}"
---
{% set url = post.origUrl %}
{% set img = post.image or "https://tripdusk.com/assets/img/og-image.svg" %}
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3381513533522940" crossorigin="anonymous"></script>
  {% include "analytics.njk" %}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ post.title }} — TripDusk</title>
  <meta name="description" content="{{ post.description }}" />

  <link rel="canonical" href="{{ url }}" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#190f2b" />
  <meta name="author" content="TripDusk" />

  <link rel="icon" type="image/svg+xml" href="/assets/img/logo.svg" />
  <link rel="apple-touch-icon" href="/assets/img/logo.svg" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="TripDusk" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{ post.title }}" />
  <meta property="og:description" content="{{ post.description }}" />
  <meta property="og:url" content="{{ url }}" />
  <meta property="og:image" content="{{ img }}" />
  <meta property="article:published_time" content="{{ post.date }}" />
  <meta property="article:modified_time" content="{{ post.modified }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ post.title }}" />
  <meta name="twitter:description" content="{{ post.description }}" />
  <meta name="twitter:image" content="{{ img }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "@id": "https://tripdusk.com/#organization", "name": "TripDusk", "url": "https://tripdusk.com/", "logo": "https://tripdusk.com/assets/img/logo.svg" },
      { "@type": "WebSite", "@id": "https://tripdusk.com/#website", "url": "https://tripdusk.com/", "name": "TripDusk", "publisher": { "@id": "https://tripdusk.com/#organization" }, "inLanguage": "en" },
      {
        "@type": "BlogPosting",
        "@id": {{ (url + "#article") | dump | safe }},
        "headline": {{ post.title | dump | safe }},
        "description": {{ post.description | dump | safe }},
        "image": {{ img | dump | safe }},
        "datePublished": {{ post.date | dump | safe }},
        "dateModified": {{ post.modified | dump | safe }},
        "author": { "@type": "Organization", "name": "TripDusk" },
        "publisher": { "@id": "https://tripdusk.com/#organization" },
        "mainEntityOfPage": {{ url | dump | safe }},
        "articleSection": {{ cat | dump | safe }},
        "inLanguage": "en"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tripdusk.com/" },
          { "@type": "ListItem", "position": 2, "name": {{ cat | dump | safe }}, "item": "https://tripdusk.com/destinations.html" },
          { "@type": "ListItem", "position": 3, "name": {{ post.title | dump | safe }}, "item": {{ url | dump | safe }} }
        ]
      }
    ]
  }
  </script>
</head>
<body data-page="">

  <article>
    <section class="page-hero">
      <div class="bg" style="background:linear-gradient(135deg,#2a1a55,#6d2f7a 40%,#d4557f 70%,#ff8a5e)"></div>
      <svg class="hills" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="#190f2b" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path opacity="0.5" d="M0 240 L240 180 L520 230 L820 175 L1120 225 L1440 185 V320 H0 Z"/>
        <path d="M0 320 L0 285 L300 255 L640 290 L980 258 L1440 288 V320 Z"/>
      </svg>
      <div class="wrap" style="max-width:820px">
        <p class="crumbs reveal"><a href="/index.html">Home</a> / {{ cat }}</p>
        <h1 class="h-xl reveal" data-d="1">{{ post.title }}</h1>
        <div class="post-meta reveal" data-d="2">
          <span>✍ TripDusk</span>
          <span>🗓 {{ post.date | humanDate }}</span>
          {% if post.cats.length %}<span>🏷 {{ post.cats | join(", ") }}</span>{% endif %}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:48px">
      <div class="wrap">
        <div class="prose reveal">
          {% if post.image %}<figure><img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy" /></figure>{% endif %}
          {{ post.contentHtml | safe }}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="cta-band reveal">
          <div class="bg"></div>
          <h2 class="h-lg">One golden guide, every Friday</h2>
          <p>Join our newsletter for hand-picked destinations, itineraries and photography tips.</p>
          <form class="subscribe" data-demo>
            <input type="email" placeholder="you@email.com" required aria-label="Email address" />
            <button class="btn btn-light" type="submit">Subscribe</button>
          </form>
          <p class="form-result form-note" style="color:rgba(255,255,255,0.85)"></p>
        </div>
      </div>
    </section>
  </article>

  <script src="/assets/js/main.js"></script>
</body>
</html>
